{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CrowClaw",
  "version": "0.1.0-alpha.1",
  "identifier": "au.com.crowloki.crowclaw",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CrowClaw",
        "width": 1180,
        "height": 760,
        "minWidth": 920,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "CrowClaw",
    "homepage": "https://github.com/CrowLoki/CrowClaw-Desktop",
    "category": "Productivity",
    "shortDescription": "Local-first Windows desktop AI agent",
    "longDescription": "CrowClaw is an installable Windows desktop AI agent with local-model connections, persistent conversations, tasks, and approval-gated tools.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
